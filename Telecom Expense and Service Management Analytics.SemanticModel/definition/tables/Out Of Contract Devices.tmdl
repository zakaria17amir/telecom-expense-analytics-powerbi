	column 'Contract Ends'
		dataType: dateTime
		formatString: Long Date
		lineageTag: 4461efa6-c76c-49f5-882f-ef2059489e4c
		summarizeBy: none
		sourceColumn: Contract Ends

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Contract Status' =
			IF(
			    ISBLANK('Out Of Contract Devices'[Contract Start Date]),
			    "No Contract",
			    IF(
			        'Out Of Contract Devices'[Contract Ends] < TODAY(),
			        "Out of Contract",
			        "In Contract"
			    )
			)
		lineageTag: ccff82a4-1c16-46b1-ab8e-bb69fc249e8a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Out Of Contract Devices' = m
		mode: import
		source =
				let
				    Source = LoadCsv("Out Of Contract Devices", {{"International Number", type text}, {"Line Status", type text}, {"Carrier", type text}, {"Contract Start Date", type date}, {"Contract Ends", type date}})
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

