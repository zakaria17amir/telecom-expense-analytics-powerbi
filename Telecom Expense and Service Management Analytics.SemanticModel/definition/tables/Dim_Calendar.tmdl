	hierarchy 'FiscalYear Hierarchy'
		lineageTag: 0caeff9b-a603-4ce6-bcf5-2b5b95391fd3

		level FiscalYear
			lineageTag: fc792f30-49c5-4157-ae52-d3015c162cd3
			column: FiscalYear

		level FiscalQuarter
			lineageTag: 16a3848f-3a74-4577-b2f0-a06979620b94
			column: FiscalQuarter

		level FiscalMonth
			lineageTag: 0c76e94f-b78e-4b5a-b1da-800c35da23d1
			column: FiscalMonth

	partition Dim_Calendar = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR ( DATE ( 2023, 7, 1 ), TODAY() ),
				
				    "DateAsInteger",     FORMAT ( [Date], "YYYYMMDD" ),
				    "Year",              YEAR ( [Date] ),
				    "FiscalYear",        IF ( MONTH ( [Date] ) <= 6, 
				                              "FY" & FORMAT ( [Date], "yy" ), 
				                              "FY" & FORMAT ( DATE ( YEAR ( [Date] ) + 1, MONTH ( [Date] ), 1 ), "yy" ) ),
				    "FiscalYearNum",     IF ( MONTH ( [Date] ) <= 6, YEAR ( [Date] ), YEAR ( [Date] ) + 1 ),
				    "FiscalMonthNumber", IF ( MONTH ( [Date] ) >= 7, MONTH ( [Date] ) - 6, MONTH ( [Date] ) + 6 ),
				    "MonthNumber",       MONTH ( [Date] ),
				    "YearMonthNumber",   FORMAT ( [Date], "YYYYMM" ),
				    "FiscalMonth",       FORMAT ( [Date], "MMM" ),
				    "MonthNameShort",    FORMAT ( [Date], "mmm" ),
				    "MonthNameLong",     FORMAT ( [Date], "mmmm" ),
				    "Quarter",           "Q" & FORMAT ( [Date], "Q" ),
				    "FiscalQuarter",     "Q" & IF ( MONTH ( [Date] ) <= 3, 3, IF ( MONTH ( [Date] ) <= 6, 4, IF ( MONTH ( [Date] ) <= 9, 1, 2 ) ) ),
				    "DayOfWeekNumber",   WEEKDAY ( [Date] ),
				    "DayOfWeek",         FORMAT ( [Date], "dddd" ),
				    "IsWeekend",         IF ( WEEKDAY ( [Date] ) IN { 1, 7 }, TRUE (), FALSE () ),
				    "Last Refresh",      NOW()
				)
				```

	annotation PBI_Id = c8a97e652799469daabe249fc86b0d02

